package com.example.util

import android.content.Context
import android.util.Log
import java.io.BufferedReader
import java.io.InputStreamReader

object DrugCsvImporter {

    // Abhi testing ke liye return type List<Any> rakha hai
    fun readCsvFromAssets(context: Context, fileName: String): List<Any> {
        val drugList = mutableListOf<Any>()
        
        try {
            val inputStream = context.assets.open(fileName)
            val reader = BufferedReader(InputStreamReader(inputStream))
            
            reader.readLine() // Header skip karein
            
            var line: String?
            while (reader.readLine().also { line = it } != null) {
                if (line!!.isBlank()) continue
                
                val cols = line!!.split(",")
                if (cols.size < 23) continue

                // Abhi ke liye sirf dummy data add kar rahe hain taaki build pass ho jaye
                drugList.add(Any()) 
            }
            reader.close()
        } catch (e: Exception) {
            Log.e("CsvImporter", "Error reading CSV", e)
        }
        
        return drugList
    }
}