package com.example.drugdoseinfo.util // Dhyan rahe, yahan apna actual package name likhein

import android.content.Context
import android.util.Log
import com.example.drugdoseinfo.model.* // Apne model package ka naam yahan dalein
import java.io.BufferedReader
import java.io.InputStreamReader
import java.util.UUID

object DrugCsvImporter {

    fun readCsvFromAssets(context: Context, fileName: String): List<Drug> {
        val drugList = mutableListOf<Drug>()
        
        try {
            // Assets folder se file open karna
            val inputStream = context.assets.open(fileName)
            val reader = BufferedReader(InputStreamReader(inputStream))
            
            // Row 1 (Header row) ko skip karna
            reader.readLine() 
            
            var line: String?
            while (reader.readLine().also { line = it } != null) {
                // Agar line khali hai toh skip karein
                if (line!!.isBlank()) continue

                // CSV ko comma (,) se todna
                val cols = line!!.split(",")
                
                // Agar columns kam hain, toh error se bachne ke liye skip karein
                if (cols.size < 23) {
                    Log.w("CsvImporter", "Skipping incomplete line: $line")
                    continue
                }

                try {
                    // 1. Formulations ko parse karna (Caret ^ aur Pipe | se)
                    val formulationsString = cols[15].trim()
                    val parsedFormulations = formulationsString.split("|").mapNotNull { formStr ->
                        val parts = formStr.trim().split("^")
                        if (parts.size == 3) {
                            Formulation(
                                id = UUID.randomUUID().toString(),
                                name = parts[0],
                                type = FormulationType.OTHER, // Default
                                concentrationMg = parts[1].toDoubleOrNull() ?: 0.0,
                                volumeMl = parts[2].toDoubleOrNull() ?: 1.0,
                                unitLabel = parts[0]
                            )
                        } else null
                    }

                    // 2. Default Regimen setup karna
                    val defaultRegimen = IndicationRegimen(
                        id = UUID.randomUUID().toString(),
                        name = cols[7].trim(),
                        description = "", 
                        defaultMgPerKgPerDay = if (cols[8].trim() == "DAY") cols[9].trim().toDoubleOrNull() ?: 0.0 else 0.0,
                        defaultMgPerKgPerDose = if (cols[8].trim() == "DOSE") cols[9].trim().toDoubleOrNull() ?: 0.0 else null,
                        frequencyTimesPerDay = cols[10].trim().toIntOrNull() ?: 1,
                        frequencyDescription = cols[11].trim(),
                        maxSingleDoseMg = cols[12].trim().toDoubleOrNull() ?: 0.0,
                        maxDailyDoseMg = cols[13].trim().toDoubleOrNull() ?: 0.0,
                        standardDurationDays = cols[14].trim().toIntOrNull() ?: 7
                    )

                    // 3. Poora Drug Object banana
                    val drug = Drug(
                        id = cols[0].trim(),
                        name = cols[1].trim(),
                        genericName = cols[2].trim(),
                        // Agar category match na ho toh app crash na kare isliye try-catch
                        category = try { DrugCategory.valueOf(cols[3].trim()) } catch (e: Exception) { DrugCategory.OTHER },
                        subtitle = cols[4].trim(),
                        description = cols[5].trim(),
                        minAgeMonths = cols[6].trim().toIntOrNull() ?: 0,
                        defaultRegimen = defaultRegimen,
                        formulations = parsedFormulations,
                        indications = cols[16].trim().split("|").map { it.trim() }.filter { it.isNotEmpty() },
                        contraindications = cols[17].trim().split("|").map { it.trim() }.filter { it.isNotEmpty() },
                        warnings = cols[18].trim().split("|").map { it.trim() }.filter { it.isNotEmpty() },
                        sideEffects = cols[19].trim().split("|").map { it.trim() }.filter { it.isNotEmpty() },
                        administrationAdvice = cols[20].trim(),
                        reconstitutionStorage = cols[21].trim(),
                        adultDoseSummary = cols[22].trim(),
                        standardRegimenSummary = cols[7].trim(),
                        isCustom = false 
                    )

                    drugList.add(drug)

                } catch (e: Exception) {
                    Log.e("CsvImporter", "Error parsing row: $line", e)
                }
            }
            reader.close()
        } catch (e: Exception) {
            e.printStackTrace()
        }
        
        return drugList
    }
}
